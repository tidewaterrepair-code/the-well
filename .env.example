# Copy this file to .env and fill it in:   cp .env.example .env && nano .env
# Never paste these values into a chat, a screenshot or GitHub.

# The address people type. No slash at the end.
PUBLIC_URL=https://engine.buildblackwell.com

# Any long random text. Make one with:  openssl rand -hex 32
APP_SECRET=

# ---- Stripe (dashboard.stripe.com > Developers > API keys). Use the sk_test_ key until launch day.
STRIPE_SECRET_KEY=
# From Developers > Webhooks, after you add  PUBLIC_URL/api/stripe/webhook  (starts with whsec_)
STRIPE_WEBHOOK_SECRET=
# true = let Stripe Tax work out sales tax (needs Stripe Tax turned on in your dashboard)
STRIPE_TAX=false

# ---- Shipping, in cents. 695 = $6.95 per order. FREE_SHIPPING_OVER_CENTS=0 turns free shipping off.
SHIPPING_CENTS=695
FREE_SHIPPING_OVER_CENTS=0
SHIP_COUNTRIES=US

# ---- Your private orders page at /admin
ADMIN_USER=keeper
ADMIN_PASSWORD=

# ---- Before launch: a password on the whole site (username can be anything). Empty = site is public.
PREVIEW_PASSWORD=

# ---- How paid orders reach Yoycol: manual (you place them from /admin), dryrun, or yoycol (API)
FULFILLMENT_MODE=manual
YOYCOL_API_KEY=
YOYCOL_API_SECRET=
YOYCOL_BASE_URL=

# ---- n8n: one webhook receives every event (order.paid, order.shipped, order.attention,
#      chamber.opened, chamber.sealed, signup.created)
N8N_EVENTS_WEBHOOK=
EVENTS_SECRET=

# ---- Sigil hunt: the secret tap order (ids from config/scene.json) and the reward (a Stripe promotion code)
SIGIL_SEQUENCE=a,b,c
SIGIL_REWARD_CODE=

# ---- Only used by Claude Code when it builds your n8n workflows (docs/PROMPTS.md, step 7)
N8N_URL=
N8N_API_KEY=
POSTIZ_URL=
POSTIZ_API_KEY=
